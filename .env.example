# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# PURPOSE:
#   Template for the database settings. Each developer copies this file to
#   ".env" in the same folder:
#       cp .env.example .env
#
#   Both Docker (docker-compose.yml) and the Express server (server/db.js)
#   read the values from .env, so they always agree on how to connect.
#
#   .env is listed in .gitignore, so your real password is never pushed to
#   GitHub. Only this example file is committed.
# =============================================================================

# Name of the database
POSTGRES_DB=roommate_finder

# Username the server logs in to the database with
POSTGRES_USER=roommate_user

# Database password (change it for anything beyond local development)
POSTGRES_PASSWORD=change_me

# Where the server finds the database. "localhost" works because
# docker-compose.yml exposes the container's port on your laptop.
# If port 5432 is already taken on your laptop (for example by a PostgreSQL
# you installed yourself), change POSTGRES_PORT to something like 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
